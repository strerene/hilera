{
  "name": "hilera",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-cards.js && vite dev",
    "build": "node scripts/generate-cards.js && vite build",
    "cards:generate": "node scripts/generate-cards.js",
    "gh-pages:build": "node scripts/generate-cards.js && BASE_PATH=/hilera vite build && test -f dist/client/index.html && test -f dist/client/404.html && touch dist/client/.nojekyll",
    "gh-pages:deploy": "bun run gh-pages:build && bunx gh-pages -d dist/client --dotfiles",
    "start": "vite preview",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solidjs/meta": "2.0.0",
    "@solidjs/router": "2.0.0",
    "@solidjs/web": "2.0.1",
    "peerjs": "^1.5.5",
    "solid-js": "2.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.0.0",
    "@types/node": "^24.0.0",
    "daisyui": "^5.7.28",
    "filesystem-routing": "0.5.0",
    "prerender-crawler": "^0.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vite": "^8.3.8"
  }
}
