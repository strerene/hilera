{
  "name": "hilera",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-cards.js && vite dev",
    "build": "node scripts/generate-cards.js && vite build",
    "cards:generate": "node scripts/generate-cards.js",
    "gh-pages:build": "node scripts/generate-cards.js && BASE_PATH=/sequence vite build && test -f .output/public/index.html && cp .output/public/index.html .output/public/404.html && touch .output/public/.nojekyll",
    "gh-pages:deploy": "bun run gh-pages:build && bunx gh-pages -d .output/public --dotfiles",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "bun test"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.8",
    "@solidjs/router": "^1.0.3",
    "@solidjs/start": "2.2.2",
    "nitro": "3.0.260903-beta",
    "peerjs": "^1.5.5",
    "solid-js": "1.9.19",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.28",
    "tailwindcss": "^4.3.3"
  }
}
